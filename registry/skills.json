    {
      "id": "codegraph",
      "kind": "upstream",
      "license": "MIT",
      "when": { "always": true },
      "official": {
        "windows": "irm https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.ps1 | iex",
        "linux": "curl -fsSL https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.sh | sh",
        "darwin": "curl -fsSL https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.sh | sh"
      },
      "preinstall": {
        "windows": [["npm", "install", "-g", "@colbymchenry/codegraph"]],
        "linux": [["npm", "install", "-g", "@colbymchenry/codegraph"]],
        "darwin": [["npm", "install", "-g", "@colbymchenry/codegraph"]]
      },
      "install": {
        "windows": [["codegraph", "install", "--target={codegraphTargets}", "--location=local", "--yes"]],
        "linux": [["codegraph", "install", "--target={codegraphTargets}", "--location=local", "--yes"]],
        "darwin": [["codegraph", "install", "--target={codegraphTargets}", "--location=local", "--yes"]]
      },
      "postinstall": {
        "windows": [["codegraph", "init", "--yes"]],
        "linux": [["codegraph", "init", "--yes"]],
        "darwin": [["codegraph", "init", "--yes"]]
      }
    },
    {
      "id": "graphify",
      "kind": "upstream",
      "license": "MIT",
      "when": { "always": true },
      "optional": true,
      "requiresCommand": "uv",
      "missingHelp": "https://docs.astral.sh/uv/getting-started/installation/",
      "preinstall": {
        "windows": [["uv", "tool", "install", "graphifyy"]],
        "linux": [["uv", "tool", "install", "graphifyy"]],
        "darwin": [["uv", "tool", "install", "graphifyy"]]
      },
      "install": {
        "windows": [["graphify", "install", "--project", "--platform", "{graphifyPlatform}"]],
        "linux": [["graphify", "install", "--project", "--platform", "{graphifyPlatform}"]],
        "darwin": [["graphify", "install", "--project", "--platform", "{graphifyPlatform}"]]
      },
      "postinstall": {
        "windows": [["graphify", "extract", ".", "--code-only"]],
        "linux": [["graphify", "extract", ".", "--code-only"]],
        "darwin": [["graphify", "extract", ".", "--code-only"]]
      }
