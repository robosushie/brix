    {
      "id": "codegraph",
      "kind": "upstream",
      "license": "MIT",
      "when": {
        "any": [
          "codeIndex.codegraph"
        ]
      },
      "official": {
        "windows": "irm https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.ps1 | iex",
        "linux": "curl -fsSL https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.sh | sh",
        "darwin": "curl -fsSL https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.sh | sh"
      },
      "preinstall": {
        "windows": [
          [
            "npm",
            "install",
            "-g",
            "@colbymchenry/codegraph"
          ]
        ],
        "linux": [
          [
            "npm",
            "install",
            "-g",
            "@colbymchenry/codegraph"
          ]
        ],
        "darwin": [
          [
            "npm",
            "install",
            "-g",
            "@colbymchenry/codegraph"
          ]
        ]
      },
      "install": {
        "windows": [
          [
            "codegraph",
            "install",
            "--target={codegraphTargets}",
            "--location=local",
            "--yes"
          ]
        ],
        "linux": [
          [
            "codegraph",
            "install",
            "--target={codegraphTargets}",
            "--location=local",
            "--yes"
          ]
        ],
        "darwin": [
          [
            "codegraph",
            "install",
            "--target={codegraphTargets}",
            "--location=local",
            "--yes"
          ]
        ]
      },
      "postinstall": {
        "windows": [
          [
            "codegraph",
            "init",
            "--yes"
          ]
        ],
        "linux": [
          [
            "codegraph",
            "init",
            "--yes"
          ]
        ],
        "darwin": [
          [
            "codegraph",
            "init",
            "--yes"
          ]
        ]
      },
      "name": "CodeGraph",
      "description": "Live code graph over MCP for source, call paths, and blast radius."
    },
    {
      "id": "graphify",
      "kind": "upstream",
      "license": "MIT",
      "when": {
        "any": [
          "codeIndex.graphify"
        ]
      },
      "optional": true,
      "requiresCommand": "uv",
      "missingHelp": "https://docs.astral.sh/uv/getting-started/installation/",
      "preinstall": {
        "windows": [
          [
            "uv",
            "tool",
            "install",
            "graphifyy"
          ]
        ],
        "linux": [
          [
            "uv",
            "tool",
            "install",
            "graphifyy"
          ]
        ],
        "darwin": [
          [
            "uv",
            "tool",
            "install",
            "graphifyy"
          ]
        ]
      },
      "install": {
        "windows": [
          [
            "graphify",
            "install",
            "--project",
            "--platform",
            "{graphifyPlatform}"
          ]
        ],
        "linux": [
          [
            "graphify",
            "install",
            "--project",
            "--platform",
            "{graphifyPlatform}"
          ]
        ],
        "darwin": [
          [
            "graphify",
            "install",
            "--project",
            "--platform",
            "{graphifyPlatform}"
          ]
        ]
      },
      "postinstall": {
        "windows": [
          [
            "graphify",
            "extract",
            ".",
            "--code-only"
          ]
        ],
        "linux": [
          [
            "graphify",
            "extract",
            ".",
            "--code-only"
          ]
        ],
        "darwin": [
          [
            "graphify",
            "extract",
            ".",
            "--code-only"
          ]
        ]
      },
      "name": "Graphify",
      "description": "Knowledge graph of code plus docs and other project files."
